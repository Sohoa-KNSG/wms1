NODE_ENV=production
HOST=127.0.0.1
PORT=8080

# Khi HOST không phải localhost, bắt buộc đặt token ngẫu nhiên và cấu hình
# cùng giá trị trong VITE_DEVICE_AGENT_TOKEN hoặc localStorage của trình duyệt.
DEVICE_AGENT_TOKEN=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

SCALE_PORT=/dev/ttyUSB0
SCALE_BAUD_RATE=9600
SCALE_DELIMITER=\r\n
SCALE_RECONNECT_MS=3000
SCALE_STALE_MS=5000
SCALE_STABLE_SAMPLES=3
SCALE_STABLE_TOLERANCE_KG=0.02
MOCK_SCALE=false
MOCK_SCALE_WEIGHT_KG=15.45

# tcp: máy in mạng port 9100; usb: thiết bị /dev/usb/lp0
PRINTER_MODE=tcp
MOCK_PRINTER=false
PRINTER_NAME=DEFAULT_PRINTER
PRINTER_HOST=192.168.1.200
PRINTER_PORT=9100
PRINTER_DEVICE=/dev/usb/lp0
PRINTER_TIMEOUT_MS=5000
PRINTER_MAX_JOB_BYTES=262144
PRINT_JOB_CACHE_MS=3600000
